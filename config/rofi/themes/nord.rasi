* {
    /* Nord Color Palette */
    nord0:  #2e3440;
    nord1:  #3b4252;
    nord2:  #434c5e;
    nord3:  #4c566a;
    nord4:  #d8dee9;
    nord5:  #e5e9f0;
    nord6:  #eceff4;
    nord7:  #8fbcbb;
    nord8:  #88c0d0;
    nord9:  #81a1c1;
    nord10: #5e81ac;
    nord11: #bf616a;
    nord12: #d08770;
    nord13: #ebcb8b;
    nord14: #a3be8c;
    nord15: #b48ead;

    /* General Settings */
    font: "JetBrainsMono Nerd Font Mono 11"; 
    
    background-color:   transparent;
    text-color:         @nord4;
    accent-color:       @nord8;
    urgent-color:       @nord11;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

mainbox {
    padding: 12px 24px;
    background-color: @nord0;
}

window {
    border-color: @nord1;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-right: 50px; 
    padding-left: 50px; 
    
    location: center;
    width: 700px;
    border: 2px;
}

inputbar {
    margin: 0 0 7px 0px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-right: 50px; 
    padding-left: 50px; 
    spacing: 12px;
    background-color: #3b4252;
    border-radius: 10px;
    children:   [   entry ];
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
    padding: 10px;
}

prompt {
    text-color: @accent-color;
}

listview {
    lines:      8;
    columns:    1;
    fixed-height: false;
}

element {
    padding:    8px;
    spacing:    8px;
    margin-top: 5px;
    margin-bottom: 5px;
}

element normal normal {
    text-color: white;
}

element normal urgent {
    text-color: @urgent-color;
}

element normal active {
    text-color: @accent-color;
}

element selected {
    text-color: white;
}

element selected normal, element selected active {
    background-color:  @nord2;
    border-radius: 40px;
}

element selected urgent {
    background-color:   @urgent-color;
}

element-icon {
    size:   0.8em;
}

element-text {
    text-color: inherit;
}
